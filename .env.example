ADDR=127.0.0.1:8080
COLLECTOR_INTERVAL_MS=2000
HISTORY_SIZE=300
MAX_PROCESSES=100
# Optional explicit path. Leave empty to use the per-user data directory;
# a relative path enables portable current-working-directory mode.
CONTEXT_DB_PATH=
AI_CONTEXT_TOKEN_BUDGET=8000

# Optional OpenAI-compatible Chat Completions endpoint.
# Leave AI_BASE_URL and AI_MODEL empty to run monitoring without embedded AI.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_JSON_MODE=true
SYSTEM_MONITOR_MCP_REPORT_DIR=

# Examples (uncomment and edit one provider):
# OpenAI:
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# DeepSeek:
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# Ollama:
# AI_API_KEY=
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.1
# LM Studio:
# AI_API_KEY=
# AI_BASE_URL=http://127.0.0.1:1234/v1
# AI_MODEL=local-model
# vLLM:
# AI_API_KEY=
# AI_BASE_URL=http://127.0.0.1:8000/v1
# AI_MODEL=your-served-model
